# History files
.Rhistory
.Rapp.history

# Session Data files
.RData

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md


# Ignore everything in 0_data except folder structure
0_data/**
!0_data/**/
!0_data/**/.gitkeep
!0_data/**/*.R

# But track everything in 0_data/v2_scripts
!0_data/v2_scripts/**

# Ignore everything in 2_pipeline except folder structure
2_pipeline/**
!2_pipeline/**/
!2_pipeline/**/.gitkeep

# Ignore everything in 3_output except folder structure
3_output/**
!3_output/**/
!3_output/**/.gitkeep

# ...but keep the small, diffable summaries of each experiment:
# the run record, the report and the summary tables. They are
# what lets experiments be compared from the repository alone.
# Per-species detail (coefficient_summary.csv,
# parity_terms.csv) is large and is rebuilt from the
# 2_pipeline/ stores, so it stays ignored.
!3_output/**/run_record.md
!3_output/**/report.md
!3_output/**/tables/parity_summary.csv
!3_output/**/tables/coverage.csv
!3_output/**/tables/metric_summary.csv
!3_output/**/tables/v2_self_agreement_summary.csv

AGENTS.md
CLAUDE.md
