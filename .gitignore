# History files
.Rhistory
.Rapp.history

# Session Data files
.RData

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md


# Ignore everything in 0_data except folder structure
0_data/**
!0_data/**/
!0_data/**/.gitkeep
!0_data/**/*.R

# But track everything in 0_data/v2_scripts
!0_data/v2_scripts/**

# Ignore everything in 2_pipeline except folder structure
2_pipeline/**
!2_pipeline/**/
!2_pipeline/**/.gitkeep

# Ignore everything in 3_output except folder structure
3_output/**
!3_output/**/
!3_output/**/.gitkeep

# ...but keep the run records. They are the committed artefact
# of a run: the stores they describe are gitignored, so when
# those are gone the record is what is left. Small, text, and
# built to be diffed between experiments.
!3_output/**/run_record.md
!3_output/**/run_record.txt

AGENTS.md
CLAUDE.md
